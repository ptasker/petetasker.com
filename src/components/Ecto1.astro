<ghost-patrol id="ghost-patrol" class="patrol" data-boss-testing={import.meta.env.DEV || undefined}>
  <section class="cabinet" aria-labelledby="patrol-title">
    <div class="dashboard">
      <div class="identity"><span class="indicator" aria-hidden="true"></span><h2 id="patrol-title">GHOST PATROL</h2><span class="edition">ARCADE / 01</span></div>
      <div class="readouts">
        <span>SCORE <b data-score>00</b></span>
        <span>BEST <b data-best>00</b></span>
      </div>
    </div>
    <div class="stage">
      <canvas tabindex="0" aria-label="Ghost Patrol game. Use up and down arrows or W and S to aim, hold Space to catch ghosts, and press Escape to pause." aria-describedby="patrol-help">Your browser needs Canvas support to play Ghost Patrol.</canvas>
      <div class="overlay">
        <span class="eyebrow" data-eyebrow>OFF THE CLOCK. ON PATROL.</span>
        <h3 data-heading>Got a minute to bust some ghosts?</h3>
        <p data-message>Hold your stream to drain a ghost, then spring the trap.<br />Clear each level’s quota — they get faster every time.</p>
        <ol class="runs" data-runs hidden></ol>
        <div class="actions">
          <button class="start" type="button" disabled>Loading sprites…</button>
          <button class="share" type="button" hidden>Copy result</button>
        </div>
      </div>
      <button class="trap" type="button" hidden>TRAP! <kbd>T</kbd></button>
      <div class="level-up" hidden>
        <strong data-banner-level>LEVEL 2</strong>
        <span data-banner-note>Ghosts ×1.14 · trap 6</span>
      </div>
      <div class="mission" hidden>
        <span data-level>LEVEL 1</span>
        <span data-quota>0/5 trapped</span>
        <span data-lives>3 escapes left</span>
        <span class="combo" data-combo hidden>1x</span>
        <span class="boost" data-boost hidden></span>
        <button class="pause" type="button">Pause</button>
      </div>
    </div>
    <div class="controls">
      <p id="patrol-help"><span class="desktop-help">↑ ↓ aim · hold SPACE to fire · T to trap</span><span class="touch-help">Hold on a ghost to drain it, then tap TRAP!</span><span class="help-tail"> · don’t let them pass!</span></p>
      <span class="dispatch" role="status" aria-live="polite">Awaiting dispatch</span>
    </div>
  </section>
</ghost-patrol>

<script>
  import { GhostPatrol } from '../scripts/ghost-patrol';
  if (!customElements.get('ghost-patrol')) customElements.define('ghost-patrol', GhostPatrol);
</script>

<style>
  /* Light is the base palette; the site's theme toggle adds .dark to <html>. */
  .patrol {
    --edge: #cbd5e1;
    --panel: #f8fafc;
    --rule: #e2e8f0;
    --ink: #1e293b;
    --dim: #64748b;
    --accent: #3f8a1a;
    --accent-soft: #4d9e22;
    --accent-ink: #ffffff;
    --veil-strong: #f8fafcee;
    --veil-mid: #f8fafc33;
    --shadow: #64748b1f;
    display: block;
    max-width: 896px;
    margin: 28px auto 0;
    padding: 0 24px;
    font-family: 'Share Tech Mono', monospace;
    /* Deep links land here: clear the sticky header rather than tucking under it. */
    scroll-margin-top: 5rem;
    /* Holding the trigger is a long press on a phone, which otherwise starts iOS text
       selection and pops the Copy / Look Up callout over the game. Nothing in here is
       worth selecting, so turn both off across the whole cabinet. */
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* Below Tailwind's md breakpoint the header grows a second nav row. */
  @media (max-width: 767px) { .patrol { scroll-margin-top: 7rem; } }
  /* Arriving via #ghost-patrol should be obvious. */
  .patrol:target .cabinet {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent), 0 12px 36px var(--shadow);
  }
  :global(html.dark) .patrol {
    --edge: #334155;
    --panel: #080e19;
    --rule: #253042;
    --ink: #e2e8f0;
    --dim: #94a3b8;
    --accent: #bef264;
    --accent-soft: #a3e635;
    --accent-ink: #101b05;
    --veil-strong: #080e19e8;
    --veil-mid: #080e1933;
    --shadow: #02061714;
  }
  .cabinet { overflow: hidden; border: 1px solid var(--edge); border-radius: 12px; background: var(--panel); color: var(--ink); box-shadow: 0 12px 36px var(--shadow); }
  .dashboard, .controls { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 15px 20px; }
  .dashboard { border-bottom: 1px solid var(--rule); }
  .identity, .readouts { display: flex; align-items: center; gap: 12px; }
  h2 { margin: 0; font-size: 15px; letter-spacing: .12em; font-weight: 700; }
  .indicator { width: 7px; height: 7px; background: var(--accent-soft); box-shadow: 0 0 12px var(--accent-soft); }
  .edition, .readouts, .controls { font-size: 11px; color: var(--dim); }
  .edition { margin-left: 5px; letter-spacing: .07em; }
  .readouts { gap: 20px; white-space: nowrap; }
  b { color: var(--accent); font-weight: 400; font-size: 17px; margin-left: 5px; }
  .stage { position: relative; height: 300px; }
  canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; image-rendering: pixelated; }
  :global(ghost-patrol[data-playing] canvas) { touch-action: none; }
  canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
  .overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; padding: 24px 36px; text-align: right; background: linear-gradient(90deg, transparent, var(--veil-mid) 30%, var(--veil-strong) 68%); }
  .overlay[hidden], .mission[hidden], .combo[hidden], .trap[hidden], .level-up[hidden] { display: none; }
  /* Between-level card, shown over the emptied street. */
  .level-up {
    position: absolute; inset: 0; z-index: 3;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    text-align: center;
  }
  .level-up strong { font-family: 'VT323', monospace; font-size: 46px; font-weight: 400; letter-spacing: .06em; color: var(--accent); line-height: 1; }
  .level-up span { font-size: 11px; letter-spacing: .12em; color: var(--dim); }
  /* Sits over the stunned ghost; the game positions it in percentages of the stage. */
  .trap {
    position: absolute; z-index: 2; transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 6px;
    border: 2px solid #fde68a; border-radius: 5px;
    background: #f59e0b; color: #1c1207;
    padding: 7px 13px; font-size: 14px; letter-spacing: .09em; font-weight: 700;
    box-shadow: 0 0 0 3px #f59e0b33, 0 6px 18px #0006;
    animation: trap-pulse .55s ease-in-out infinite alternate;
  }
  .trap kbd { font: inherit; font-size: 10px; border: 1px solid #92400e66; border-radius: 3px; padding: 0 4px; background: #fffbeb99; }
  /* No keyboard to press on a touch device, and the stage is too narrow to spare it. */
  @media (pointer: coarse) { .trap kbd { display: none; } }
  .trap:hover { background: #fbbf24; }
  @keyframes trap-pulse { from { transform: translate(-50%, -50%) scale(1); } to { transform: translate(-50%, -50%) scale(1.07); } }
  @media (prefers-reduced-motion: reduce) { .trap { animation: none; } }
  .eyebrow { font-size: 10px; letter-spacing: .16em; color: var(--accent); }
  h3 { max-width: 300px; margin: 10px 0; font-size: 27px; line-height: 1.05; font-family: 'VT323', monospace; font-weight: 400; }
  .overlay p { font-size: 12px; line-height: 1.7; color: var(--dim); margin: 0 0 18px; }
  button { cursor: pointer; font: inherit; }
  .actions { display: flex; align-items: center; gap: 8px; }
  .runs { margin: 0 0 12px; padding: 0; list-style: none; font-size: 11px; color: var(--dim); line-height: 1.75; }
  .runs[hidden] { display: none; }
  .runs li[data-latest] { color: var(--accent); }
  .share { background: transparent; color: var(--dim); border: 1px solid var(--edge); border-radius: 4px; padding: 8px 12px; font-size: 12px; }
  .share:hover { color: var(--ink); border-color: var(--dim); }
  .share[hidden] { display: none; }
  .start { background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent-soft); border-radius: 4px; padding: 9px 18px; font-size: 13px; }
  .start:hover { background: var(--accent-soft); }
  .start:disabled { opacity: .5; cursor: wait; }
  button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .mission { position: absolute; top: 12px; left: 20px; right: 20px; display: flex; align-items: center; gap: 14px; color: var(--ink); font-size: 12px; pointer-events: none; }
  .mission [data-level] { color: var(--accent); letter-spacing: .08em; }
  .combo { color: var(--accent); font-size: 14px; }
  .boost { color: #f59e0b; font-size: 11px; letter-spacing: .08em; }
  .boost[hidden] { display: none; }
  .pause { margin-left: auto; pointer-events: auto; border: 1px solid var(--edge); border-radius: 4px; background: var(--panel); color: var(--ink); padding: 4px 10px; }
  .controls { padding-top: 12px; padding-bottom: 12px; border-top: 1px solid var(--rule); }
  .controls p { margin: 0; }
  .dispatch { color: var(--accent); text-align: right; }
  .touch-help { display: none; }
  @media (pointer: coarse) { .desktop-help { display: none; } .touch-help { display: inline; } }
  @media (max-width: 640px) {
    .patrol { padding: 0 16px; margin-top: 20px; }
    .dashboard, .controls { padding: 12px; gap: 8px; }
    .edition, .help-tail { display: none; }
    .identity { gap: 7px; }
    h2 { font-size: 12px; }
    .readouts { font-size: 10px; gap: 10px; }
    b { font-size: 14px; margin-left: 2px; }
    .overlay { align-items: center; justify-content: flex-start; text-align: center; padding: 24px 16px; background: linear-gradient(var(--veil-strong) 30%, var(--veil-mid) 65%, transparent); }
    h3 { font-size: 25px; margin: 8px 0; }
    .overlay p { font-size: 11px; margin-bottom: 12px; }
    .controls { font-size: 10px; }
    .dispatch { max-width: 100px; }
    .mission { gap: 9px; font-size: 10px; left: 12px; right: 12px; }
    .trap { padding: 6px 11px; font-size: 12px; }
    .level-up strong { font-size: 36px; }
  }
</style>
